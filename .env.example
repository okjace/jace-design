# From your Jace account: Manage account → Developer → register an app.
# Redirect URI to register: https://YOUR-DOMAIN/api/auth/callback  (and http://localhost:3000/api/auth/callback for dev)
JACE_CLIENT_ID=
JACE_CLIENT_SECRET=
# Any long random string, used to sign session cookies.
SESSION_SECRET=
# Postgres connection string. Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
# Leave empty locally to use an embedded database stored in .data/
DATABASE_URL=
# Optional: public URL of the site, used for links in emails (defaults to the request's origin).
APP_URL=
# Optional: built-in AI on free AI services. Add any of these keys (used in this order, falling back to the next):
#   Google Gemini (free, just a Google account): https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
#   OpenRouter (free models, 50 requests a day): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pick models yourself (otherwise a current free one is chosen), and AI requests per person per day (default 40).
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
AI_DAILY_LIMIT=
