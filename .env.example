# From your Jace account: Manage account → Developer → register an app.
# Redirect URI to register: https://YOUR-DOMAIN/api/auth/callback  (and http://localhost:3000/api/auth/callback for dev)
JACE_CLIENT_ID=
JACE_CLIENT_SECRET=
# Any long random string, used to sign session cookies.
SESSION_SECRET=
# Postgres connection string. Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
# Leave empty locally to use an embedded database stored in .data/
DATABASE_URL=
# Optional: public URL of the site, used for links in emails (defaults to the request's origin).
APP_URL=
# Optional: built-in AI on Groq's free tier. Free key at https://console.groq.com/keys (no card needed).
GROQ_API_KEY=
# Optional: which Groq model (default openai/gpt-oss-120b) and AI requests per person per day (default 40).
GROQ_MODEL=
AI_DAILY_LIMIT=
